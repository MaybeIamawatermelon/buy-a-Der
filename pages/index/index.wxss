/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #fff7f0 0%, #f4f6fb 60%, #eef1f7 100%);
}

.page-scroll {
  flex: 1;
  overflow-y: hidden;
}

.wrap {
  min-height: 100%;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero {
  text-align: center;
  margin-bottom: 44rpx;
}

.hero-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #1b1b1f;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #8a8f9c;
  letter-spacing: 1rpx;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 34rpx 34rpx;
  box-shadow: 0 16rpx 48rpx rgba(24, 32, 56, 0.08);
}

.field + .field {
  margin-top: 32rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a4f5c;
  margin-bottom: 14rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f5f6fa;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #1b1b1f;
  min-height: 96rpx;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.55;
}

.ph {
  color: #b3b8c4;
}

.btn {
  margin-top: 40rpx;
  padding: 0;
  width: 100%;
  height: 100rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  padding-left: 4rpx; /* 抵消字间距造成的视觉偏左 */
  text-align: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b4a 0%, #ff3d6e 100%);
  box-shadow: 0 14rpx 34rpx rgba(255, 61, 110, 0.28);
  border: none;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn-hover {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.result {
  margin-top: 44rpx;
  text-align: center;
  opacity: 0;
  transform: translateY(18rpx);
  transition: opacity 0.28s ease, transform 0.28s ease;
  pointer-events: none;
}

.result-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.result-text {
  font-size: 96rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  color: #ff3d6e;
  text-shadow: 0 10rpx 28rpx rgba(255, 61, 110, 0.18);
}

.result-quip {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #6b7180;
}

.result-reset {
  display: inline-block;
  margin-top: 26rpx;
  font-size: 28rpx;
  color: #9aa0ad;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e2e5ed;
}

.footer {
  margin-top: auto;
  padding-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b3b8c4;
  letter-spacing: 1rpx;
}
